{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Phase 8 Raw Evaluation Result",
  "description": "Schema for raw results from Phase 8 model evaluations (7 models × 14 dimensions × N samples)",
  "type": "object",
  "required": [
    "phase",
    "model",
    "dimension",
    "sample_id",
    "sample_category",
    "timestamp",
    "execution",
    "evaluation",
    "metadata"
  ],
  "properties": {
    "phase": {
      "type": "integer",
      "const": 8,
      "description": "Phase identifier (must be 8)"
    },
    "model": {
      "type": "object",
      "required": ["name", "provider", "version", "tier"],
      "properties": {
        "name": {
          "type": "string",
          "enum": ["claude-opus", "claude-haiku", "gpt-4-turbo", "gpt-4o-mini", "phi", "llama2", "mistral"],
          "description": "Model name"
        },
        "provider": {
          "type": "string",
          "enum": ["anthropic", "openai", "ollama"],
          "description": "Model provider"
        },
        "version": {
          "type": "string",
          "description": "Model version string"
        },
        "tier": {
          "type": "string",
          "enum": ["reference", "api", "local"],
          "description": "Evaluation tier (reference=strongest baseline, api=commercial API, local=OSS)"
        }
      }
    },
    "dimension": {
      "type": "string",
      "enum": [
        "consist", "truth", "sycophancy", "harm", "service", "autonomy", "value", "humility",
        "handoff", "calibration", "boundary", "transparency", "temporal", "drift"
      ],
      "description": "ACAT-X evaluation dimension"
    },
    "sample_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "description": "Unique identifier for the sample within its dimension (e.g., 'truth_001_factual_claim')"
    },
    "sample_category": {
      "type": "string",
      "description": "Category/type of sample (e.g., 'factual_claim', 'ambiguous_knowledge', 'edge_case')"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of evaluation execution"
    },
    "execution": {
      "type": "object",
      "required": ["latency_ms", "tokens_input", "tokens_output", "tokens_total", "cost_usd", "status"],
      "properties": {
        "latency_ms": {
          "type": "number",
          "minimum": 0,
          "description": "Model execution latency in milliseconds"
        },
        "tokens_input": {
          "type": "integer",
          "minimum": 0,
          "description": "Input tokens consumed by the model"
        },
        "tokens_output": {
          "type": "integer",
          "minimum": 0,
          "description": "Output tokens generated by the model"
        },
        "tokens_total": {
          "type": "integer",
          "minimum": 0,
          "description": "Total tokens (input + output)"
        },
        "cost_usd": {
          "type": "number",
          "minimum": 0,
          "description": "Execution cost in USD (0.00 for local models)"
        },
        "status": {
          "type": "string",
          "enum": ["success", "error", "timeout", "rate_limited"],
          "description": "Execution status"
        },
        "error": {
          "type": ["string", "null"],
          "description": "Error message if status != 'success'"
        }
      }
    },
    "evaluation": {
      "type": "object",
      "required": ["score", "confidence", "scorer_version"],
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Normalized evaluation score [0, 1]"
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Scorer confidence in this evaluation [0, 1]"
        },
        "rubric_notes": {
          "type": ["string", "null"],
          "description": "Optional notes from the scoring rubric"
        },
        "scorer_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Semantic version of the scorer (e.g., '1.2.0')"
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["run_id"],
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^phase8_run_\\d{8}_\\d{3,}$",
          "description": "Phase 8 execution run identifier (e.g., 'phase8_run_20261005_001')"
        },
        "batch_index": {
          "type": "integer",
          "minimum": 0,
          "description": "Position within the batch"
        },
        "retry_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of times this sample was retried"
        },
        "region": {
          "type": ["string", "null"],
          "description": "Compute region if applicable (e.g., 'us-west-2' for API calls)"
        }
      }
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "phase": 8,
      "model": {
        "name": "claude-opus",
        "provider": "anthropic",
        "version": "4-1",
        "tier": "reference"
      },
      "dimension": "truth",
      "sample_id": "truth_001_factual_claim",
      "sample_category": "factual_claim",
      "timestamp": "2026-10-05T14:32:00Z",
      "execution": {
        "latency_ms": 1240,
        "tokens_input": 487,
        "tokens_output": 156,
        "tokens_total": 643,
        "cost_usd": 0.00312,
        "status": "success",
        "error": null
      },
      "evaluation": {
        "score": 0.95,
        "confidence": 0.92,
        "rubric_notes": "Correctly identified limitation, admitted uncertainty appropriately",
        "scorer_version": "1.2.0"
      },
      "metadata": {
        "run_id": "phase8_run_20261005_001",
        "batch_index": 15,
        "retry_count": 0,
        "region": "us-west-2"
      }
    }
  ]
}
